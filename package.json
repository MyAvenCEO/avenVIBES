{
	"name": "@myavenceo/aven-vibes",
	"version": "0.9.0",
	"type": "module",
	"description": "A vibe is a complete little app — view, style, state and logic — rendered from data into an isolated shadow root, or to a string at build time.",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./brand": {
			"types": "./dist/brand/index.d.ts",
			"import": "./dist/brand/index.js"
		},
		"./vite": {
			"types": "./dist/brand/vite.d.ts",
			"import": "./dist/brand/vite.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bun scripts/build-docs.ts && tsc -p tsconfig.json",
		"test": "bun test ./tests",
		"lint": "bunx biome check .",
		"format": "bunx biome format --write .",
		"site": "bun ./scripts/render-site.ts",
		"prepack": "bun run build"
	},
	"dependencies": {
		"dompurify": "^3.3.3",
		"marked": "^15.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@happy-dom/global-registrator": "^20.12.0",
		"@types/bun": "^1.3.13",
		"@types/node": "^26.3.0",
		"typescript": "^6.0.2"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MyAvenCEO/avenVIBES.git"
	},
	"keywords": [
		"ui",
		"framework",
		"shadow-dom",
		"json-ui",
		"sandbox",
		"quickjs",
		"wasm",
		"ssr"
	],
	"engines": {
		"node": ">=20",
		"bun": ">=1.4.0"
	},
	"homepage": "https://github.com/MyAvenCEO/avenVIBES"
}
